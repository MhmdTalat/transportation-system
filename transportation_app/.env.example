# Copy to .env and replace the placeholder secret before running locally.
DEBUG=True
SECRET_KEY=replace-with-a-unique-random-secret
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# SQLite is suitable for local development only. Production should use PostgreSQL.
USE_SQLITE=True
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432

FRONTEND_BASE_URL=http://127.0.0.1:5173
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Set EMAIL_HOST_USER and EMAIL_HOST_PASSWORD to your Gmail address and Google App Password.
# DEFAULT_FROM_EMAIL defaults to EMAIL_HOST_USER when it is configured.
CACHE_URL=redis://127.0.0.1:6379/1
REDIS_URL=redis://127.0.0.1:6379/1
PRIVATE_MEDIA_ROOT=private_media

BOOKING_CANCELLATION_CUTOFF_HOURS=2
MAX_ACTIVE_UPCOMING_BOOKINGS=5
DRIVER_PASSENGER_PHONE_WINDOW_HOURS=2
